# TestPilot AI Backend Configuration

# Server
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Database
DATABASE_URL=sqlite:///./testpilot.db

# Security & Execution Controls
SSRF_PROTECTION_ENABLED=true
DEFAULT_TIMEOUT_SECONDS=10.0
MAX_TIMEOUT_SECONDS=30.0
MAX_REQUEST_SIZE_BYTES=5242880
MAX_RESPONSE_SIZE_BYTES=10485760

# AI Configuration (Optional: defaults to built-in rule-based expert engine if not set)
AI_PROVIDER=rule_based
# Optional LLM integration (Leave blank to use intelligent rule-based engine)
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_MODEL=
